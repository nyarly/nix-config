#!/usr/bin/env fish

test (count $argv) -ge 1; or exit 1
set -l branchname $argv[1]
git switch -c $branchname
git symbolic-ref HEAD | grep -q "^refs/heads/$branchname" || exit 1

set -l summary (echo $branchname | sed 's/.*/\u&/; s/[-_]/ /g')

set -l jira_id (acli jira workitem create --from-json (
  acli jira workitem create --generate-json | yq -P "\
    .summary = \"$summary\" |
    .reporter = \"@me\" |
    .type = \"Task\" |
    .projectKey = \"DOP\" |
    .labels = [] |
    (.description.content[0].content[0].text = \"\") |
    del(.additionalAttributes) |
    del(.assignee) |
    del(.parentIssueId) |
    . " | vipe | yq -o json | psub
) | sed 's/.*Work item \(\S*\).*/\1/')

git jira-branch $jira_id
