#!/usr/bin/env bash

if [ $# -lt 1 ]; then
  echo "Usage: $0 <issue key...>"
fi

#path=$(git symbolic-ref HEAD) || (echo "Not on a branch"; exit 1)
#branch=${path#refs/heads/}
branch=$(git rev-parse --abbrev-ref HEAD)
if [ $? -ne 0 ]; then
  echo "Not on a branch"
  exit 1
fi

while [ $# -gt 0 ]; do
  issue=$1
  shift

  config="branch.${branch}.jira-ticket"

  if git config --get-all "$config" | grep -q "^${issue}$"; then
    continue
  fi

  git config --add "$config" "$issue"
  if ! echo $branch | grep -Eq -- "-[A-Z]{2,}-[0-9]+$"; then #XXX issue patterns
    oldbranch=$branch
    branch=$branch-$issue
    git branch -m $oldbranch $branch
  fi
  acli jira workitem assign --key "$issue" --assignee "@me"
done
